    {
      "ConcreteType": "DSRevitNodesUI.WallTypes, DSRevitNodesUI",
      "SelectedIndex": 3,
      "SelectedString": "STB 20.0",
      "Id": "16ebeca796054d8f923afbaf528319bd",
