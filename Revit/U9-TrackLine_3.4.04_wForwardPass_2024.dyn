    },
    {
      "ConcreteType": "CoreNodeModels.Input.DoubleSlider, CoreNodeModels",
      "NumberType": "Double",
      "MaximumValue": 50.0,
      "MinimumValue": 5.0,
      "StepValue": 0.1,
      "Id": "5a1fb6986487418a80057656a50ca8a1",
      "NodeType": "NumberInputNode",
      "Inputs": [],
      "Outputs": [
        {
          "Id": "5f6d3e15c28d4dbabb280bdded66e5e8",
          "Name": "",
          "Description": "Double",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Produces numeric values",
      "InputValue": 8.0
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# Load the Python Standard and DesignScript Libraries\r\nimport clr\r\nimport math\r\n\r\nfrom System.Collections.Generic import List\r\n\r\nclr.AddReference('ProtoGeometry')\r\nfrom Autodesk.DesignScript.Geometry import *\r\n\r\n#Import Revit Nodes\r\nclr.AddReference(\"RevitNodes\")\r\nimport Revit\r\nclr.ImportExtensions(Revit.Elements)\r\nclr.ImportExtensions(Revit.GeometryConversion)\r\n\r\n# Import RevitAPI\r\nclr.AddReference(\"RevitAPI\")\r\nimport Autodesk\r\nfrom Autodesk.Revit.DB import *\r\nfrom Autodesk.Revit.DB.Architecture import *\r\n\r\n# Import DocumentManager and TransactionManager\r\nclr.AddReference(\"RevitServices\")\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\nfrom collections import defaultdict\r\n\r\n# The inputs to this node will be stored as a list in the IN variables.\r\n# Length - Width - height variables\r\n\r\n################################################################################################################\r\n################################################################################################################\r\n# Input parameters\r\n################################################################################################################\r\n################################################################################################################\r\nlevelEG = UnwrapElement(IN[0])\r\nallElements = UnwrapElement(IN[1])\r\nisDeleteAll = IN[2]\r\n\r\ngeneralParameterList = IN[3]\r\nnumberOfLevels = generalParameterList[0]\r\ntrackLineCount = generalParameterList[1]\r\nnumberofExits = generalParameterList[2]\r\ncolumnRows = generalParameterList[3]\r\ncolumnSpacing = generalParameterList[4]\r\nwallHeight = generalParameterList[5]\r\n\r\nverticalTransportationList = IN[4]\r\nnumberOfStairs = verticalTransportationList[0]\r\nstairWidth = verticalTransportationList[1]\r\nescOrientation = verticalTransportationList[2]\r\nnumberOfEscalators = verticalTransportationList[3]\r\nescalatorWidth = verticalTransportationList[4]\r\nelevatorPosition = verticalTransportationList[5]\r\nelevatorLength = verticalTransportationList[6]\r\n\r\nclearanceVariablesList = IN[5]\r\nescExitClearance = clearanceVariablesList[0]\t\t#[m] DIN EN 115-1 \r\nstairExitClearance = clearanceVariablesList[1]\t\t#[m] Ril.813.0202 5(5)\r\nelevatorExitClearance = clearanceVariablesList[2]\t#[m] Ril.813.0202 7(5)\r\nminPathWidth = clearanceVariablesList[3]\t\t\t#[m] Ril.813.0202 4(3)\r\n\r\nWidthCalcList = IN[6]\r\nplatformWidth = WidthCalcList[0]\r\nplatformHeight = WidthCalcList[1]\r\ntrafficLevel = WidthCalcList[2]\r\nregional = WidthCalcList[3]\r\nouterTrack = WidthCalcList[4]\r\ninnerTracks = WidthCalcList[5]\r\ndistTracks = WidthCalcList[6]\r\ndistTrackPlatform = WidthCalcList[7]\r\ndangerZone = WidthCalcList[8]\r\nsafetyStripPlatform = WidthCalcList[9]\r\n\r\ntopLevelList = IN[7]\r\nexitOffset = topLevelList[0]\r\nnumberOfMachines = topLevelList[1]\r\nticketXOffset = topLevelList[2]\r\n\r\ncrowditList = IN[8]\r\n\r\nlength = IN[9]\r\n\r\ntypeList = IN[10]\r\nfloorType = UnwrapElement(typeList[0])\r\nwallType = UnwrapElement(typeList[1])\r\ncolumnType = UnwrapElement(typeList[2])\r\nstairType = UnwrapElement(typeList[3])\r\nescalatorType = UnwrapElement(typeList[4])\r\ntrainType = UnwrapElement(typeList[5])\r\ntrainWallType = UnwrapElement(typeList[6])\r\natmType = UnwrapElement(typeList[7])\r\nticketType = UnwrapElement(typeList[8])\r\nstoreType = UnwrapElement(typeList[9])\r\nvalidatorType = UnwrapElement(typeList[10])\r\n\r\npassengers = IN[11]\r\nviewToKeep = IN[12]\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\n# Place your code below this line\r\nplatformCount=int(math.ceil(float(trackLineCount)/2))\r\nwallThickness= UnitUtils.ConvertFromInternalUnits(wallType.Width, UnitTypeId.Meters)\r\n\r\nwidth = platformCount * platformWidth + (platformCount - 1) * (innerTracks) + wallThickness\r\nif trackLineCount %2 ==0:\r\n    width += 2 * outerTrack\r\nelse:\r\n    width += outerTrack\r\n\r\nyAxisList = []\r\nrevitApiYAxisList = []\r\nfor indexY in range(platformCount):\r\n    yAxis = (indexY * platformWidth) + outerTrack + wallThickness/2 + indexY * innerTracks\r\n    yAxisList.append(yAxis)\r\n    revitApiYAxisList.append(UnitUtils.ConvertToInternalUnits(yAxis, UnitTypeId.Meters))\r\n\r\nescalatorLength = (wallHeight * 1.732050808) + 3.5 + 2.950 + 0.4 #Family specific\r\n\r\n# Revit Api Unit Type Conversion\r\nrevitApiLength = UnitUtils.ConvertToInternalUnits(length, UnitTypeId.Meters)\r\nrevitApiWidth = UnitUtils.ConvertToInternalUnits(width, UnitTypeId.Meters)\r\nrevitApiWallHeight = UnitUtils.ConvertToInternalUnits(wallHeight, UnitTypeId.Meters)\r\nrevitApiPlatformHeight = UnitUtils.ConvertToInternalUnits(platformHeight, UnitTypeId.Meters)\r\nrevitApiPlatformWidth = UnitUtils.ConvertToInternalUnits(platformWidth, UnitTypeId.Meters)\r\nrevitApiStairWidth = UnitUtils.ConvertToInternalUnits(stairWidth, UnitTypeId.Meters)\r\nrevitApiEscalatorWidth = UnitUtils.ConvertToInternalUnits(escalatorWidth, UnitTypeId.Meters)\r\nrevitApiEscalatorLength = UnitUtils.ConvertToInternalUnits(escalatorLength, UnitTypeId.Meters)\r\nrevitApiElevatorLength = UnitUtils.ConvertToInternalUnits(elevatorLength, UnitTypeId.Meters)\r\n\r\n\r\n#Start Transaction\r\nTransactionManager.Instance.EnsureInTransaction(doc)\r\n\r\n# Before Run delete everything for the first time Revit Opened \r\nlevelArr = FilteredElementCollector(doc).OfCategory(BuiltInCategory.OST_Levels).WhereElementIsNotElementType().ToElements()\r\nviewArr = FilteredElementCollector(doc).OfCategory(BuiltInCategory.OST_Views).ToElements()\r\n\r\n################################################################################################################\r\n################################################################################################################\r\n# Delete existing elements\r\n################################################################################################################\r\n################################################################################################################\r\nif isDeleteAll:\r\n    present_familyInstances = list(FilteredElementCollector(doc).OfClass(FamilyInstance))\r\n    present_walls = FilteredElementCollector(doc).OfCategory(BuiltInCategory.OST_Walls).WhereElementIsNotElementType().ToElements()\r\n    present_floors = FilteredElementCollector(doc).OfCategory(BuiltInCategory.OST_Floors).WhereElementIsNotElementType().ToElements()\r\n    present_levels = FilteredElementCollector(doc).OfCategory(BuiltInCategory.OST_Levels).WhereElementIsNotElementType().ToElements()\r\n    # views = FilteredElementCollector(doc).OfCategory(BuiltInCategory.OST_Views).WhereElementIsNotElementType().ToElements()\r\n    for view in viewArr:\r\n        if view.Name != viewToKeep.Name and view.ViewType == ViewType.FloorPlan:\r\n            # print (str(view.Title), str(view.Id), str(view.Name))\r\n            doc.Delete(view.Id)\r\n            # doc.Regenerate()\r\n    def delete(elements):\r\n        for element in elements:\r\n            doc.Delete(element.Id)\r\n\r\n    delete(present_familyInstances)\r\n    delete(present_walls)\r\n    delete(present_floors)\r\n    delete([lvl for lvl in present_levels if round(lvl.Elevation,2) != 0.0])\r\n    doc.Regenerate()\r\n\r\n\r\n################################################################################################################\r\n################################################################################################################\r\n# Create surrounding walls, levels and floors \r\n################################################################################################################\r\n################################################################################################################\r\npoint1 = XYZ(0, 0, 0)\r\npoint2 = XYZ(revitApiLength, 0, 0)\r\npoint3 = XYZ(revitApiLength, revitApiWidth, 0)\r\npoint4 = XYZ(0, revitApiWidth, 0)\r\n\r\n# Create 4 Line/Curve for 4 Walls\r\nline1 = Autodesk.Revit.DB.Line.CreateBound(point1, point2)\r\nline2 = Autodesk.Revit.DB.Line.CreateBound(point2, point3)\r\nline3 = Autodesk.Revit.DB.Line.CreateBound(point3, point4)\r\nline4 = Autodesk.Revit.DB.Line.CreateBound(point4, point1)\r\nwall1 = Autodesk.Revit.DB.Wall.Create(doc, line1, wallType.Id, levelEG.Id, numberOfLevels * revitApiWallHeight, -revitApiPlatformHeight, False, False)\r\nwall2 = Autodesk.Revit.DB.Wall.Create(doc, line2, wallType.Id, levelEG.Id, numberOfLevels * revitApiWallHeight, -revitApiPlatformHeight, False, False)\r\nwall3 = Autodesk.Revit.DB.Wall.Create(doc, line3, wallType.Id, levelEG.Id, numberOfLevels * revitApiWallHeight, -revitApiPlatformHeight, False, False)\r\nwall4 = Autodesk.Revit.DB.Wall.Create(doc, line4, wallType.Id, levelEG.Id, numberOfLevels * revitApiWallHeight, -revitApiPlatformHeight, False, False)\r\nwallList = [wall1, wall2, wall3, wall4]\r\n\r\n# Base Level Floor creation\r\nfloorList = []\r\n    \r\ncarray = CurveLoop()\r\ncarray.Append(line1)\r\ncarray.Append(line2)\r\ncarray.Append(line3)\r\ncarray.Append(line4)\r\n\r\nfloor = Autodesk.Revit.DB.Floor.Create(doc, [carray], floorType.Id, levelEG.Id)\r\n# floor = doc.Create.NewFloor(carray, floorType, levelEG, False)\r\nfloor.GetParameters(\"Height Offset From Level\")[0].Set(-revitApiPlatformHeight)\r\nfloorList.append(floor)\r\n\r\n# Upper Level and their Floor creation based on numberOfLevels arg\r\nlevelList = []\r\nlevelList.append(levelEG)\r\nif numberOfLevels > 1:\r\n    for levelNumber in range(1, numberOfLevels):\r\n        newLevel = Autodesk.Revit.DB.Level.Create(doc, levelNumber * revitApiWallHeight)\r\n        levelList.append(newLevel)\r\n        lineF1 = Autodesk.Revit.DB.Line.CreateBound(XYZ(point1.X, point1.Y, levelNumber*revitApiWallHeight), XYZ(point2.X, point2.Y, levelNumber*revitApiWallHeight))\r\n        lineF2 = Autodesk.Revit.DB.Line.CreateBound(XYZ(point2.X, point2.Y, levelNumber*revitApiWallHeight), XYZ(point3.X, point3.Y, levelNumber*revitApiWallHeight))\r\n        lineF3 = Autodesk.Revit.DB.Line.CreateBound(XYZ(point3.X, point3.Y, levelNumber*revitApiWallHeight), XYZ(point4.X, point4.Y, levelNumber*revitApiWallHeight))\r\n        lineF4 = Autodesk.Revit.DB.Line.CreateBound(XYZ(point4.X, point4.Y, levelNumber*revitApiWallHeight), XYZ(point1.X, point1.Y, levelNumber*revitApiWallHeight))\r\n        carray = CurveLoop()\r\n        carray.Append(lineF1)\r\n        carray.Append(lineF2)\r\n        carray.Append(lineF3)\r\n        carray.Append(lineF4)\r\n        # newFloor = doc.Create.NewFloor(carray, floorType, newLevel, False)\r\n        newFloor = Autodesk.Revit.DB.Floor.Create(doc, [carray], floorType.Id, newLevel.Id)\r\n        floorList.append(newFloor)\r\n        \r\n    levelNumber += 1\r\n    newLevel = Autodesk.Revit.DB.Level.Create(doc, (levelNumber - 1) * revitApiWallHeight + UnitUtils.ConvertToInternalUnits(4.5, UnitTypeId.Meters))\r\n    levelList.append(newLevel)\r\n\r\n\r\n################################################################################################################\r\n################################################################################################################\r\n# Determine Revit family positions\r\n################################################################################################################\r\n################################################################################################################\r\nfamilyInstancesList = []\r\nholeList = []\r\n#Offset to yAxis\r\nminDistToEdge = (platformWidth - escalatorWidth * numberOfEscalators - stairWidth * numberOfStairs)/2 #assures centered placement if ElevatorWidth was the decisive size after guidelines\r\n\r\n#xAxis Centered\r\nxAxisCenter = length/2\r\n\r\n# Parameters for lower escalator positioning (dependant on elevator position)\r\nif elevatorPosition == 1: \t#left\r\n    xAxisEscalator =  minPathWidth + escExitClearance + wallThickness/2# +- for both sides; Wallthickness/2 because it referrs to wall axis\r\n    xAxisCenter += elevatorLength\r\n    occupiedXSpaceElevator = (0,elevatorLength + elevatorExitClearance + wallThickness/2)\r\nelif elevatorPosition == 2:\t#middle\r\n    xAxisEscalator = elevatorLength/2 + elevatorExitClearance + minPathWidth + escExitClearance + wallThickness/2 # +- for both sides\r\n    occupiedXSpaceElevator = (xAxisCenter - elevatorLength/2 - elevatorExitClearance - minPathWidth, xAxisCenter + elevatorLength/2 + elevatorExitClearance + minPathWidth)\r\nelif elevatorPosition == 3:\t#right\r\n    xAxisEscalator =  minPathWidth + escExitClearance + wallThickness/2\r\n    xAxisCenter -= elevatorLength\t\r\n    occupiedXSpaceElevator = (length - elevatorLength - elevatorExitClearance - wallThickness/2, length)\t\r\n\r\n# Parameters dependant on escalator orientation (True: Facing Inwards; False: Outwards)\r\nif escOrientation:\r\n    revitApiOrientationOffsetLeft = 0\r\n    revitApiOrientationOffsetRight = revitApiEscalatorWidth\r\n    rotationAngle = 0\r\n    wallOrientation = 1\r\nelse:\r\n    revitApiOrientationOffsetLeft = revitApiEscalatorWidth\r\n    revitApiOrientationOffsetRight = 0\r\n    rotationAngle = math.pi\r\n    wallOrientation = -1\r\n    xAxisEscalator += escalatorLength \r\n\r\nrevitApiEscalatorXStartRight = UnitUtils.ConvertToInternalUnits(xAxisCenter + xAxisEscalator, UnitTypeId.Meters)\r\nrevitApiEscalatorXStartLeft  = UnitUtils.ConvertToInternalUnits(xAxisCenter - xAxisEscalator, UnitTypeId.Meters)\r\n\r\n# Placements\r\nfor yIndex in range(platformCount):\r\n    yAxis = yAxisList[yIndex] # Bottom Edge of the Platform #PlatformyAxis\r\n    escalatorYStart = yAxis+ minDistToEdge \t\t\t\t\t\t \r\n    revitApiEscalatorYStart = UnitUtils.ConvertToInternalUnits(escalatorYStart, UnitTypeId.Meters)\r\n    \r\n    # Elevators\r\n    # Start is bottom left point\r\n    if elevatorPosition == 1:\r\n        revitApiElevatorXStart = 0\t\r\n    elif elevatorPosition == 2:\r\n        revitApiElevatorXStart = revitApiLength/2 - revitApiElevatorLength/2\r\n    elif elevatorPosition == 3: \r\n        revitApiElevatorXStart = revitApiLength - revitApiElevatorLength\r\n                \r\n    # place the elevator in the middle of the platform\r\n    revitApiDistanceToPlatformAxis = (revitApiPlatformWidth - revitApiElevatorLength)/2\t\t\t\t\t\t\t\t\t\t\r\n    revitApiElevatorYStart = UnitUtils.ConvertToInternalUnits(yAxis, UnitTypeId.Meters) + revitApiDistanceToPlatformAxis\r\n            \r\n    for level in range(0, numberOfLevels - 1):\r\n        for number in range(0, numberOfEscalators):\r\n            # escalator left\r\n            escPoint_l = XYZ(revitApiEscalatorXStartLeft, revitApiEscalatorYStart + revitApiOrientationOffsetLeft , revitApiPlatformHeight + level * revitApiWallHeight)\r\n            # escalator = doc.Create.NewFamilyInstance(escPoint, escalatorType, levelList[level], Autodesk.Revit.DB.Structure.StructuralType.NonStructural)\r\n\r\n            # escalator right\r\n            escPoint_r = XYZ(revitApiEscalatorXStartRight, revitApiEscalatorYStart + revitApiOrientationOffsetRight , revitApiPlatformHeight + level * revitApiWallHeight)\r\n            # escalator = doc.Create.NewFamilyInstance(escPoint, escalatorType, levelList[level], Autodesk.Revit.DB.Structure.StructuralType.NonStructural)\r\n\r\n            #offset for next iteration\r\n            revitApiEscalatorYStart += revitApiEscalatorWidth\r\n\r\n            familyInstancesList.append([escPoint_l, (levelList[level], levelList[level+1]), escalatorType, rotationAngle, 'el'])\r\n            familyInstancesList.append([escPoint_r, (levelList[level], levelList[level+1]), escalatorType, rotationAngle, 'er'])\r\n\r\n            # Stairs\r\n            if (number == numberOfEscalators - 1) and (numberOfStairs > 0):\t\t\r\n                #left\r\n                stairPoint_l = XYZ(revitApiEscalatorXStartLeft, revitApiEscalatorYStart + revitApiStairWidth /2 , revitApiPlatformHeight + level * revitApiWallHeight)\t\t\t\r\n                #right\r\n                stairPoint_r = XYZ(revitApiEscalatorXStartRight, revitApiEscalatorYStart + revitApiStairWidth /2 , revitApiPlatformHeight + level * revitApiWallHeight)\r\n                familyInstancesList.append([stairPoint_l, (levelList[level], levelList[level+1]), stairType, rotationAngle, 'sl'])\r\n                familyInstancesList.append([stairPoint_r, (levelList[level], levelList[level+1]), stairType, rotationAngle, 'sr'])\r\n            else:\r\n                delta = 0\r\n        \r\n        revitApiEscalatorYStart -= revitApiEscalatorWidth*numberOfEscalators\r\n\r\n# Define points where exits are inserted\r\nrevitApiExitXOffset = UnitUtils.ConvertToInternalUnits(exitOffset, UnitTypeId.Meters)\r\nrevitApiTicketXOffset = UnitUtils.ConvertToInternalUnits(ticketXOffset, UnitTypeId.Meters)\r\nrevitApiTicketWidth = UnitUtils.ConvertToInternalUnits(0.8, UnitTypeId.Meters)\r\nrevitApiStoreWidth = UnitUtils.ConvertToInternalUnits(5, UnitTypeId.Meters)\r\nrevitApiRailingHeight = UnitUtils.ConvertToInternalUnits(1.2, UnitTypeId.Meters)  \r\n\r\n# define exit points\r\nexitPoint1 = XYZ(revitApiExitXOffset, UnitUtils.ConvertToInternalUnits(7, UnitTypeId.Meters), 0)\t# 7m = exitOffset in Y = inwards\r\nexitPoint2 = XYZ(revitApiLength - revitApiExitXOffset, UnitUtils.ConvertToInternalUnits(7, UnitTypeId.Meters), 0)\r\nexitPoint3 = XYZ(revitApiLength - revitApiExitXOffset - revitApiEscalatorWidth, revitApiWidth - UnitUtils.ConvertToInternalUnits(7, UnitTypeId.Meters), 0)\r\nexitPoint4 = XYZ(revitApiExitXOffset - revitApiEscalatorWidth, revitApiWidth - UnitUtils.ConvertToInternalUnits(7, UnitTypeId.Meters), 0)\r\npointList = [exitPoint1, exitPoint2, exitPoint3, exitPoint4]\r\n\r\n# for columns \r\nif escOrientation:\r\n    occupiedXSpaceEscalatorRight =  (xAxisCenter + xAxisEscalator - escExitClearance, xAxisCenter +  xAxisEscalator + escalatorLength)\r\n    occupiedXSpaceEscalatorLeft = (xAxisCenter - xAxisEscalator - escalatorLength, xAxisCenter - xAxisEscalator + escExitClearance)\r\nelse:\r\n    occupiedXSpaceEscalatorLeft =  (xAxisCenter - xAxisEscalator - escExitClearance, xAxisCenter -  xAxisEscalator + escalatorLength)\r\n    occupiedXSpaceEscalatorRight = (xAxisCenter + xAxisEscalator - escalatorLength, xAxisCenter + xAxisEscalator + escExitClearance)\r\noccupiedXSpacesList = [occupiedXSpaceElevator, occupiedXSpaceEscalatorLeft, occupiedXSpaceEscalatorRight]\r\n\r\noccupiedYSpacesEscalator = (minDistToEdge, platformWidth - minDistToEdge)\r\noccupiedYSpaceElevator = (platformWidth/2 - elevatorLength/2, platformWidth/2 + elevatorLength/2)\r\noccupiedYSpacesList = [occupiedYSpaceElevator, occupiedYSpacesEscalator]\r\n\r\n################################################################################################################\r\n################################################################################################################\r\n# Exits and Top Decoration\r\n################################################################################################################\r\n################################################################################################################\r\nif numberOfLevels > 1:\r\n    topLevel = list(levelList)[-2]\r\n    for exitId in range(0, numberofExits):\r\n        if exitId<2:\r\n            familyInstancesList.append([pointList[exitId], (topLevel, None), escalatorType, math.pi, 'et'])\r\n        else:\r\n            familyInstancesList.append([pointList[exitId], (topLevel, None), escalatorType, None, 'et'])\r\n        \r\n        stairPoint = XYZ(pointList[exitId].X + revitApiStairWidth/2, pointList[exitId].Y, 0)\r\n        if exitId<3:\r\n            familyInstancesList.append([stairPoint, (topLevel, None), stairType, math.pi, 'st'])\r\n        else:\r\n            familyInstancesList.append([stairPoint, (topLevel, None), stairType, None, 'st'])\r\n\r\n        # place storebooths\r\n        if exitId == 0:\r\n            bpoint = XYZ(pointList[exitId].X + revitApiEscalatorWidth + 30, 1, 0)\r\n            familyInstancesList.append([bpoint, (topLevel, None), storeType, None, 'storeBooth'])\r\n        elif exitId == 1:\r\n            bpoint = XYZ(pointList[exitId].X - revitApiStoreWidth - revitApiEscalatorWidth - 30, 1, 0)\r\n            # storeBooth = doc.Create.NewFamilyInstance(bpoint, storeType, topLevel, Autodesk.Revit.DB.Structure.StructuralType.NonStructural)\r\n            familyInstancesList.append([bpoint, (topLevel, None), storeType, None, 'storeBooth'])\r\n\r\n\r\n    # Place ATMs\r\n    aPoint1 = XYZ(UnitUtils.ConvertToInternalUnits(xAxisCenter, UnitTypeId.Meters), 1, 0)\r\n    aPoint2 = XYZ(UnitUtils.ConvertToInternalUnits(xAxisCenter, UnitTypeId.Meters), revitApiWidth - 3, 0)\r\n    aPointList = [aPoint1, aPoint2]\r\n    familyInstancesList.append([aPoint1, (topLevel, None), atmType, None, 'atm'])\r\n    # atm = doc.Create.NewFamilyInstance(aPoint1, atmType, topLevel, Autodesk.Revit.DB.Structure.StructuralType.NonStructural)\r\n    # decorationList.append(atm)\r\n    familyInstancesList.append([aPoint2, (topLevel, None), atmType, None, 'atm'])\r\n    # atm = doc.Create.NewFamilyInstance(aPoint2, atmType, topLevel, Autodesk.Revit.DB.Structure.StructuralType.NonStructural)\r\n    # decorationList.append(atm)\r\n    \r\n    # Place Ticketmachines\r\n    for point in aPointList:\r\n        for machineNr in range(0, numberOfMachines):\r\n            mPoint = XYZ(point.X - machineNr*revitApiTicketWidth + revitApiTicketXOffset, point.Y, point.Z)\r\n            # machine = doc.Create.NewFamilyInstance(mPoint, ticketType, topLevel, Autodesk.Revit.DB.Structure.StructuralType.NonStructural)\r\n            # decorationList.append(machine)\r\n            familyInstancesList.append([mPoint, (topLevel, None), ticketType, None, 'ticket'])\r\n        for machineNr in range(0, numberOfMachines):\r\n            mPoint = XYZ(point.X + machineNr*revitApiTicketWidth - revitApiTicketXOffset, point.Y, point.Z)\r\n            # machine = doc.Create.NewFamilyInstance(mPoint, ticketType, topLevel, Autodesk.Revit.DB.Structure.StructuralType.NonStructural)\r\n            # decorationList.append(machine)\r\n            familyInstancesList.append([mPoint, (topLevel, None), ticketType, None, 'ticket'])\r\n            \r\n    # Place Ticketvalidators\r\n    if escOrientation:\r\n        xLeft  = occupiedXSpacesList[1][0] - escExitClearance\r\n        xRight = occupiedXSpacesList[2][1] + escExitClearance\r\n        yLeft  = [revitApiEscalatorWidth * i + UnitUtils.ConvertToInternalUnits(occupiedYSpacesList[1][0], UnitTypeId.Meters) for i in range(numberOfEscalators + 1)]\r\n        yRight = [revitApiEscalatorWidth * i + revitApiEscalatorWidth + UnitUtils.ConvertToInternalUnits(occupiedYSpacesList[1][0], UnitTypeId.Meters) for i in range(numberOfEscalators)]\r\n        yRight.append(yRight[-1] + revitApiStairWidth)\r\n    else:\r\n        xLeft  = occupiedXSpacesList[1][1] + escExitClearance\r\n        xRight = occupiedXSpacesList[2][0] - escExitClearance\r\n        yRight = [revitApiEscalatorWidth * i + UnitUtils.ConvertToInternalUnits(occupiedYSpacesList[1][0], UnitTypeId.Meters) for i in range(numberOfEscalators + 1)]\r\n        yLeft  = [revitApiEscalatorWidth * i + revitApiEscalatorWidth + UnitUtils.ConvertToInternalUnits(occupiedYSpacesList[1][0], UnitTypeId.Meters) for i in range(numberOfEscalators)]\r\n        yLeft.append(yLeft[-1] + revitApiStairWidth)\r\n    if numberOfStairs == 0:\r\n        del yRight[-1]\r\n        del yLeft[-1]\r\n    for baseY in revitApiYAxisList:\t\r\n        for y in range(len(yLeft)):\r\n            pointLeft  = XYZ(UnitUtils.ConvertToInternalUnits(xLeft , UnitTypeId.Meters), yLeft[y]  + baseY, 0)\r\n            pointRight = XYZ(UnitUtils.ConvertToInternalUnits(xRight, UnitTypeId.Meters), yRight[y] + baseY, 0)\r\n            # validatorLeft  = doc.Create.NewFamilyInstance(pointLeft , validatorType, topLevel, Autodesk.Revit.DB.Structure.StructuralType.NonStructural)\r\n            # validatorRight = doc.Create.NewFamilyInstance(pointRight, validatorType, topLevel, Autodesk.Revit.DB.Structure.StructuralType.NonStructural)\r\n            familyInstancesList.append([pointLeft, (topLevel, None), validatorType, None, 'validator'])\r\n            # decorationList.append(validatorLeft)\r\n            familyInstancesList.append([pointRight, (topLevel, None), validatorType, None, 'validator'])\r\n            # decorationList.append(validatorRight)\r\n\r\n    \r\n################################################################################################################\r\n################################################################################################################\r\n# Columns\r\n################################################################################################################\r\n################################################################################################################\r\ncolumnWidth = 0.75 #[m]\r\nsafetyStripWidth = safetyStripPlatform + (0.9 + columnWidth/2) # 0.9 m Ril 813.0201A04 3(3) for small obstacles\r\nrevitApiFloorThickness = UnitUtils.ConvertToInternalUnits(0.2, UnitTypeId.Meters)\r\n\r\nif columnRows > 0:\r\n    columnCountLeft  = int( math.floor(xAxisCenter / columnSpacing)) #split because xAxisCenter not always in the middle and columns should be center orientated\r\n    columnCountRight = int( math.floor((length - xAxisCenter)/ columnSpacing) + 1)\r\n    columnStartX = xAxisCenter - columnCountLeft * columnSpacing\r\n    columnXListBefore = []\r\n    for i in range(0,(columnCountLeft + columnCountRight)):\r\n        columnXListBefore.append(i * columnSpacing + columnStartX)\r\n\r\n    # Clash detection with occupiedYSpaces; only for escalators\r\n    occupiedXSpacesColumnList = list(occupiedXSpacesList)\r\n    if columnRows > 1:\r\n        if occupiedYSpacesList[1][0] > (safetyStripWidth + columnWidth/2) and occupiedYSpacesList[1][1] > (platformCount - (safetyStripWidth + columnWidth/2)):\r\n            del occupiedXSpacesColumnList[1:3]\r\n\r\n    # Clash detection with occupiedXSpaces\r\n    columnXList = [] \r\n    for x in columnXListBefore:\r\n        i = 0\r\n        for space in occupiedXSpacesColumnList:\r\n            if not(x > space[0] and x < space[1]):\r\n                i += 1\r\n            if i == len(occupiedXSpacesColumnList):\r\n                columnXList.append(x)\r\n    # YAxis\r\n    columnYList = []\r\n    for p in range(platformCount):\r\n        if columnRows == 2:\r\n            columnYList.append(yAxisList[p] + safetyStripWidth)\r\n            columnYList.append(yAxisList[p] + platformWidth - safetyStripWidth)\r\n        elif columnRows == 1:\r\n            columnYList.append(yAxisList[p] + platformWidth/2)\r\n            \r\n    for x in columnXList:\r\n        for y in columnYList:\r\n            revitApiX = UnitUtils.ConvertToInternalUnits(x, UnitTypeId.Meters)\r\n            revitApiY = UnitUtils.ConvertToInternalUnits(y, UnitTypeId.Meters)\r\n            basePoint = XYZ(revitApiX, revitApiY, 0)\r\n            # topHeight = revitApiWallHeight - revitApiFloorThickness\r\n            familyInstancesList.append([basePoint, (levelList[0], None), columnType, None, 'c'])\r\n            # column = doc.Create.NewFamilyInstance(basePoint, columnType,  levelEG, Autodesk.Revit.DB.Structure.StructuralType.NonStructural)\r\n            # column.LookupParameter(\"Enable Analytical Model\").Set(0)\r\n            # column.LookupParameter(\"Top Offset\").Set(topHeight)\r\n            # column.LookupParameter(\"Top Level\").Set(levelEG.Id)\r\n\r\n\r\n\r\n################################################################################################################\r\n################################################################################################################\r\n# Output Lists\r\n################################################################################################################\r\n################################################################################################################\r\nbaseValueList = [length, width, platformHeight, platformWidth, wallHeight, wallThickness, trackLineCount, platformCount, columnRows, columnSpacing, numberOfLevels]\r\nrevitApiBaseList = [revitApiLength, revitApiWidth, revitApiPlatformHeight, revitApiPlatformWidth, revitApiWallHeight, revitApiStairWidth, revitApiEscalatorWidth, revitApiEscalatorLength, revitApiElevatorLength]\r\nelevationList = [numberOfEscalators, numberOfStairs, escOrientation, elevatorPosition, elevatorLength, escalatorLength, escalatorWidth, stairWidth]\r\nlistList = [levelList, floorList, wallList, yAxisList, revitApiYAxisList, clearanceVariablesList, occupiedXSpacesList, occupiedYSpacesList]\r\nupperLevelList = [exitOffset, ticketXOffset, numberOfMachines, numberofExits, pointList]\r\ntrackDataList = [distTracks, distTrackPlatform, outerTrack, innerTracks, dangerZone, safetyStripPlatform]\r\n\r\n#End Transaction\r\nTransactionManager.Instance.TransactionTaskDone()\r\n# Assign your output to the OUT variable.\r\nOUT = [baseValueList, revitApiBaseList, elevationList, listList, upperLevelList, trackDataList, typeList, crowditList, familyInstancesList]\r\n",
      "Engine": "CPython3",
