    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# Load the Python Standard and DesignScript Libraries\r\nimport sys\r\nimport clr\r\nimport os\r\nimport time\r\nclr.AddReference('ProtoGeometry')\r\nfrom Autodesk.DesignScript.Geometry import *\r\n\r\n#Import Revit Nodes\r\nclr.AddReference(\"RevitNodes\")\r\nimport Revit\r\nclr.ImportExtensions(Revit.Elements)\r\nclr.ImportExtensions(Revit.GeometryConversion)\r\n\r\nclr.AddReference(\"RevitAPI\")\r\nfrom Autodesk.Revit.DB import *\r\nfrom Autodesk.Revit.DB.Architecture import *\r\n\r\nclr.AddReference(\"RevitServices\")\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\nclr.AddReference(\"System\")\r\nfrom System.Collections.Generic import List\r\n\r\nimport tempfile\r\n# The inputs to this node will be stored as a list in the IN variables.\r\nviewList = IN[0][0]\r\nviewColorList = IN[0][1]\r\noption = IN[0][2]\r\npath = IN[1]\r\nfolderName = IN[3]\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\nTransactionManager.Instance.EnsureInTransaction(doc)\r\n# Place your code below this line\r\n\r\n# custom:\r\nonlyExportPlatforms = IN[10]\r\nassert option in [0, 1, 2]\r\ncolorExport = True if option in [1, 2] else False\r\nNN_ForwardPass = True if option==2 else False\r\n\r\nif option == 0:\r\n\tOUT = [], [], None, None, NN_ForwardPass\r\n\r\nelif option in [1, 2]:\r\n    floorTypes = FilteredElementCollector(doc).OfClass(ViewFamilyType).ToElements()\r\n    floorId = UnwrapElement(floorTypes[0]).Id\r\n\r\n    if IN[2] and (IN[5] or colorExport or IN[6] or IN[8] or IN[9]):\t\r\n        if IN[4]:\r\n            folders = os.listdir(path)\r\n            maxNumber = -1\r\n            for folder in folders:\r\n                try:\r\n                    maxNumber = max(int(folder.split(folderName)[1]),maxNumber)\r\n                except:\r\n                    print(\"Folder Error\")\r\n            maxNumber += 1\r\n            folderName += str(maxNumber)\r\n        path= os.path.join(path, folderName)\r\n        if not os.path.exists(path):\r\n            os.makedirs(path)\r\n    ##########################################################################\r\n    ##########################################################################\r\n    #View Export\r\n    ##########################################################################\r\n    ##########################################################################\r\n    exportPath = path\r\n    fileName = \"Export\"\r\n    filePath = os.path.join(exportPath, fileName)\r\n    viewEGname = None\r\n    finalExportPath = None\r\n\r\n    viewIdList = [view.Id for view in UnwrapElement(viewList)]\r\n    # custom:\r\n    if onlyExportPlatforms:\r\n        viewIdList = [view.Id for view in UnwrapElement(viewList) if view.Name.startswith(\"EG\")]\r\n    if IN[5]:\r\n        options = ImageExportOptions()\r\n        options.FilePath = filePath\r\n        options.ExportRange = ExportRange.SetOfViews\r\n        options.SetViewsAndSheets(viewIdList)\r\n        options.HLRandWFViewsFileType = ImageFileType.PNG\r\n        options.PixelSize = 2500\r\n        options.ImageResolution = ImageResolution.DPI_600\r\n        options.FitDirection = FitDirectionType.Horizontal\r\n        options.ZoomType = ZoomFitType.FitToPage\r\n        doc.ExportImage(options)\r\n    #ColorViews\r\n    viewColorIdList = [view.Id for view in UnwrapElement(viewColorList)]\r\n    # custom:\r\n    if onlyExportPlatforms:\r\n        viewColorIdList = [view.Id for view in UnwrapElement(viewColorList) if view.Name.startswith(\"EG\")]\r\n    if colorExport:\r\n        options = ImageExportOptions()\r\n        options.FilePath = filePath\r\n        options.ExportRange = ExportRange.SetOfViews\r\n        options.SetViewsAndSheets(viewColorIdList)\r\n        options.HLRandWFViewsFileType = ImageFileType.PNG\r\n        # corresponding to the dataset\r\n        options.PixelSize = 4500#2048\r\n        options.ImageResolution = ImageResolution.DPI_600\r\n        options.FitDirection = FitDirectionType.Horizontal\r\n        options.ZoomType = ZoomFitType.FitToPage\r\n        doc.ExportImage(options)\r\n        \r\n        if onlyExportPlatforms:\r\n            # find the colored view of EG\r\n            viewEGname = [v for v in viewColorList if 'EG' in v.Name][0].Name\r\n            finalExportPath = filePath+f\" - Floor Plan - {viewEGname}.png\"\r\n    ##########################################################################\r\n    ##########################################################################\r\n    # IFC Export\r\n    ##########################################################################\r\n    ##########################################################################\r\n    if IN[6]:\r\n        options=IFCExportOptions()\r\n        options.FileVersion = IFCVersion.IFC2x3CV2\r\n        options.AddOption(\"ExportUserDefinedPsets\",\"true\")\r\n        options.AddOption(\"ExportInternalRevitPropertySets\",\"false\")\r\n        options.AddOption(\"ExportBaseQuantitiesPsets\",\"false\")\r\n        options.AddOption(\"ExportExportIFCCommonPropertySets\",\"false\")\r\n        options.AddOption(\"ExportUserDefinedPsetsFileName\",str(IN[7]))\r\n            \r\n        c=doc.Export(exportPath, fileName, options)\r\n    ##########################################################################\r\n    ##########################################################################\r\n    #Dwg Export\r\n    ##########################################################################\r\n    ##########################################################################\r\n    #viewIdList = List[ElementId]([view.Id for view in UnwrapElement(viewList)])\r\n    if IN[8]:\r\n        options = DWGExportOptions()\r\n        doc.Export(exportPath, fileName, List[ElementId](viewIdList), options)\r\n    ##########################################################################\r\n    ##########################################################################\r\n    #Log Export\r\n    ##########################################################################\r\n    ##########################################################################\r\n    if IN[9]:\r\n        stdout_original = sys.stdout\r\n        stdout_file = open(exportPath + \"/Log.txt\", 'a')\r\n        sys.stdout = stdout_file\r\n        sys.stdout = stdout_original\r\n        stdout_file.close()\r\n        \r\n    TransactionManager.Instance.TransactionTaskDone()\r\n    # Assign your output to the OUT variable.\r\n    OUT = viewList, viewColorList, viewEGname, finalExportPath, NN_ForwardPass",
      "Engine": "CPython3",
      "EngineName": "CPython3",
      "VariableInputPorts": true,
      "Id": "1c53288618d5449c8403f3964fb0e68f",
